{
  "$schema": "https://opencode.ai/config.json",
  // Lets try qwen by default...
  "model": "ollama/qwen2.5-coder:14b",

  // Tell opencode that tools are supported.
  "providers": {
    "ollama": {
      "models": {
        "qwen2.5-coder:14b": {
          "capabilities": {
            "tools": true
          }
        }
      }
    }
  }
}
